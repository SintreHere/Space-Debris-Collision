# Copy to .env and fill in. Never commit .env.

# Space-Track.org credentials (free account: https://www.space-track.org)
# Optional — ingestion falls back to CelesTrak's no-auth feed without them.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# Where the TLE cache database lives (default: data/tle_cache.db)
# TLE_DB_PATH=data/tle_cache.db

# Comma-separated allowed CORS origins. Unset = "*" (dev only — set this in production).
# CORS_ORIGINS=https://your-frontend-domain.com

# Background TLE refresh cadence in seconds (default: 21600 = 6h)
# TLE_REFRESH_INTERVAL_SECONDS=21600

# Altitude band the background refresh ingests, in km
# TLE_REFRESH_MIN_ALT_KM=350
# TLE_REFRESH_MAX_ALT_KM=1250
